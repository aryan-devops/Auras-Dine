{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "restaurant_admin", "waiter", "kitchen"] },
        "tenantId": { "type": "string" }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Stores user roles"
    }
  }
}
