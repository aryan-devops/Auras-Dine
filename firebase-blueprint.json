{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "restaurant_admin", "waiter", "kitchen"] },
        "tenantId": { "type": "string" }
      },
      "required": ["uid", "role"]
    },
    "StaffCredential": {
      "title": "StaffCredential",
      "description": "Staff login credentials",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["waiter", "kitchen"] },
        "tenantId": { "type": "string" },
        "restaurantName": { "type": "string" }
      },
      "required": ["username", "password", "role", "tenantId", "restaurantName"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Stores user roles"
    },
    "/staffCredentials/{credentialId}": {
      "schema": "StaffCredential",
      "description": "Stores staff login credentials"
    }
  }
}
