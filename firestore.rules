rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin(uid) {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(uid));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin(request.auth.uid);
      allow write: if isOwner(uid) || isAdmin(request.auth.uid);
    }
    
    match /admins/{uid} {
      allow read: if isAdmin(request.auth.uid);
      allow write: if false; // Only superadmin via backend
    }
  }
}
